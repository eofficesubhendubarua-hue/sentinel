{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Accept" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/yahoo-chart/:path*",
      "destination": "https://query1.finance.yahoo.com/v8/finance/chart/:path*"
    },
    {
      "source": "/api/yahoo-quote/:path*",
      "destination": "https://query2.finance.yahoo.com/v10/finance/quoteSummary/:path*"
    },
    {
      "source": "/api/yahoo-search",
      "destination": "https://query2.finance.yahoo.com/v1/finance/search"
    },
    {
      "source": "/api/mf-search/:path*",
      "destination": "https://api.mfapi.in/mf/search?q=:path*"
    },
    {
      "source": "/api/mf-nav/:path*",
      "destination": "https://api.mfapi.in/mf/:path*"
    }
  ]
}
